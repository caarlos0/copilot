{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["**/*.mjs", "**/*.ts", "../../scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
