{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["plugins/**/*.mjs", "plugins/**/*.ts", "scripts/**/*.ts", "bench/**/*.ts", "bench/**/*.mjs"],
  "exclude": ["node_modules"]
}
